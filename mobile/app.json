{
  "expo": {
    "name": "Помощник",
    "slug": "assistant-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "assistant",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kz.assistant.mobile",
      "infoPlist": {
        "NSAlarmKitUsageDescription": "Чтобы важные напоминания звенели как будильник, даже на беззвучном."
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F3EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "kz.assistant.mobile"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Микрофон нужен, чтобы записывать то, что вы говорите помощнику.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsFileWithMaxCount": 10
          },
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "audio/*",
            "application/pdf",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.ms-excel",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "audio/*",
            "application/pdf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы сфотографировать чек или прочитать QR-код на чеке. Снимок делаете вы сами, кнопкой.",
          "microphonePermission": "Микрофон нужен, чтобы записывать то, что вы говорите помощнику.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к фото нужен, чтобы выбрать снимок чека, который вы уже сделали.",
          "cameraPermission": "Камера нужна, чтобы сфотографировать чек или прочитать QR-код на чеке. Снимок делаете вы сами, кнопкой.",
          "microphonePermission": "Микрофон нужен, чтобы записывать то, что вы говорите помощнику."
        }
      ],
      "expo-notifications"
    ]
  }
}
