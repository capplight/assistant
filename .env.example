# Telegram: token from @BotFather
BOT_TOKEN=
# Empty = long polling (local). Production: public https URL, e.g. https://bot.example.kz
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
TELEGRAM_API_BASE=

DATABASE_URL=postgresql+asyncpg://assistant:assistant@localhost:5432/assistant
POSTGRES_PASSWORD=assistant

ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_STRONG=claude-sonnet-5-5

# AI layer (assistant.ai). Keys only here in your local .env, never committed.
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
AI_PRIMARY_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=openai
# JSON list / dict values
AI_PROVIDERS_ENABLED=["anthropic","openai","google","groq"]
AI_PROVIDER_MONTHLY_USD={"anthropic":300}
AI_FALLBACK_SHARE_OF_PRIMARY=0.5
AI_FALLBACK_EMERGENCY_DAILY_USD=15
AI_ROUTES_FILE=
BUDGET_TZ=Asia/Almaty

STT_PROVIDER=groq
STT_API_KEY=
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_API_KEY=
PLACES_PROVIDER=google
PLACES_API_KEY=
INSTAGRAM_OEMBED_TOKEN=

# Mobile REST API (python -m assistant.api). Secrets: long random strings; required unless API_DEV_MODE=true.
API_HOST=127.0.0.1
API_PORT=8000
API_PUBLIC_BASE_URL=http://127.0.0.1:8000
API_DEV_MODE=false
JWT_SECRET=
HASH_KEY=
SMS_PROVIDER=fake
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.storage
